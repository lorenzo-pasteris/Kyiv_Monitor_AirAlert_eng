# Telegram user session used by Telethon to read source channels
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=replace-me
TELEGRAM_SESSION=replace-me

# Anthropic and Telegram Bot API credentials
ANTHROPIC_API_KEY=replace-me
BOT_TOKEN=123456:replace-me

# Production destinations (Telegram IDs are normally negative for groups/channels)
TARGET_CHAT_ID=-1000000000001
SUMMARY_CHAT_ID=-1000000000002
SUMMARY_CHAT_LINK=https://t.me/+replace-me
OWNER_CHAT_ID=123456789
OPS_CHAT_ID=123456789

# Comma-separated Telegram user IDs allowed to run /alert and /normal
ADMIN_USER_IDS=123456789

# Safe test-mode destination
TEST_MODE=false
TEST_CHAT_ID=-1000000000003

# Persistent Railway volume path
CATEGORY_STATS_DB_PATH=/data/kyiv_monitor_category_stats.sqlite3
