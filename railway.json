{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "pip install -r requirements-lock.txt"
  },
  "deploy": {
    "preDeployCommand": ["python predeploy_check.py"],
    "overlapSeconds": 0,
    "drainingSeconds": 0,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
