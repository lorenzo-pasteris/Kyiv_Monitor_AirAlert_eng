{
  "$schema": "https://railway.com/railway.schema.json",
  "deploy": {
    "preDeployCommand": ["/app/.venv/bin/python predeploy_check.py"],
    "startCommand": "/app/.venv/bin/python monitor.py",
    "overlapSeconds": 0,
    "drainingSeconds": 0,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
